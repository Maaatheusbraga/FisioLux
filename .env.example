# FisioLux — variáveis de ambiente (exemplo)
# Copie para .env e preencha. Nunca commite .env.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FisioLux

# Tema
NEXT_PUBLIC_DEFAULT_THEME=dark

# Database (Supabase Postgres — Prisma)
# Em redes só IPv4, o host db.*.supabase.co (Direct) pode falhar.
# Use o pooler: Transaction (6543) no DATABASE_URL e Session (5432) no DIRECT_URL.
# Senha com @ deve virar %40. Sem aspas e sem [colchetes].
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth / API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Storage
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=fisioLux
# Futuro Cloudflare R2 (quando STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# Seed (Fase 2)
SEED_CLINICA_NOME=Clínica Demo FisioLux
SEED_ADMIN_NOME=Administrador FisioLux
SEED_ADMIN_EMAIL=admin@fisiolux.local
# UUID do usuário no Supabase Auth (preencher na Fase 3)
# SEED_ADMIN_AUTH_USER_ID=
SEED_ADMIN_PASSWORD=altere-esta-senha
